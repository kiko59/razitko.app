# Supabase — nájdeš v Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Používa sa na serveri na obchádzanie RLS len tam, kde je to nutné:
# Stripe webhook a kontrola/aktualizácia predplatného v /api/extract.
# Nikdy ho nepoužívaj v kóde, ktorý beží v prehliadači.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket pre nahrané dokumenty
SUPABASE_STORAGE_BUCKET=documents

# Anthropic (Claude) API kľúč — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Voliteľné: model použitý na extrakciu (predvolene claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Verejná URL appky (v deve http://localhost:3000) — používa sa na Stripe
# Checkout/Portal redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/test/apikeys (TEST mode kľúče)
STRIPE_SECRET_KEY=sk_test_...
# https://dashboard.stripe.com/test/webhooks — signing secret konkrétneho endpointu
STRIPE_WEBHOOK_SECRET=whsec_...

# ID mesačných cien z Stripe Dashboard (Product catalog) — pozri README krok "Stripe setup"
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_FLEET=price_...
STRIPE_PRICE_PRO=price_...
