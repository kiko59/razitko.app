# Supabase — nájdeš v Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key sa používa len na serveri (API routes), nikdy v klientskom kóde
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket pre nahrané dokumenty
SUPABASE_STORAGE_BUCKET=documents

# Anthropic (Claude) API kľúč — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Voliteľné: model použitý na extrakciu (predvolene claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
