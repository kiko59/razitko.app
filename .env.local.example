# Supabase — nájdeš v Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Voliteľné: appka ho aktuálne nepoužíva (všetky DB/Storage operácie idú cez
# prihláseného používateľa a RLS). Ponechané pre prípadné budúce admin skripty —
# nikdy ho nepoužívaj v routes, ktoré majú rešpektovať RLS izoláciu medzi používateľmi.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket pre nahrané dokumenty
SUPABASE_STORAGE_BUCKET=documents

# Anthropic (Claude) API kľúč — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Voliteľné: model použitý na extrakciu (predvolene claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
